<job>
basename  = farzone_wind

<mesh>
nghost    = 4
nx1       = 256
x1min     = -20
x1max     =  20
ix1_bc    = outflow
ox1_bc    = outflow

nx2       = 256
x2min     = -20
x2max     =  20
ix2_bc    = outflow
ox2_bc    = outflow

nx3       = 256
x3min     = -20
x3max     =  20
ix3_bc    = outflow
ox3_bc    = outflow

<meshblock>
nx1       = 128
nx2       = 128
nx3       = 128

<coord>
special_rel = true     # SR MHD metric helpers on (flat spacetime)

<time>
evolution   = dynamic
integrator  = rk2
cfl_number  = 0.3
tlim        = 100.1

<mhd>
eos         = ideal
gamma       = 1.3333333333
reconstruct = ppmx
rsolver     = hlle
dfloor      = 1.0e-8
pfloor      = 3.0e-11
fofc        = true
gamma_max   = 100.0
sigma_max = 10000.0
beta_min  = 1.0e-05

<problem>
pgen_name    = farzone_wind
user_srcs    = false
user_esrcs   = true
user_reset_srcs = true

# --- geometry ---
x0           = 0.0 
y0           = 0.0
z0           = 0.0


# --- pulsar wind ---
r_star = 4.0 # radius of inner wind zone
r_blend = 6.0 # radius over which the star solution is blended with the outside
rho_surf = 1.0 # density at the star surface
gamma_wind = 5.0 # bulk lorentz factor of wind
cold_sheet = true # whether you add pressure to the sheet or not

# --- magnetosphere ---
sigma0           = 10.0    # magnetization
chi = 0.0  # current sheet thickness
beta0 = 1.0e-3 #plasma beta in wind
edge_width = 0.0 # width of edge of current sheet region, should be << tan(chi)

#----regulatization ---
frac_star = 0.3 #fraction of the star that is not set by regulatization
theta0 = 0.174532925199 # angle over which magnetic flux increases around pole
b = 0.03 # additional momentum flux added to prevent flux from going to zero at pole

# ---------------- Outputs ----------------
<output1>
file_type   = hst
data_format = %12.5e
dt          = 5.0

<output2>
file_type  = bin          # 3D binary dump (full volume)
variable   = mhd_w_bcc        # SR/NR MHD primitives: rho, press, vel1..3, etc.
dt         = 1.0

<output3>
file_type = bin
variable  = mhd_divb
dt        = 1.0
