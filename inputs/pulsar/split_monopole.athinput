<job>
basename  = split_monopole

<mesh>
nghost    = 4
nx1       = 128
x1min     = -30
x1max     =  30
ix1_bc    = outflow
ox1_bc    = outflow

nx2       = 128
x2min     = -30
x2max     =  30
ix2_bc    = outflow
ox2_bc    = outflow

nx3       = 128
x3min     = -30
x3max     =  30
ix3_bc    = outflow
ox3_bc    = outflow

<meshblock>
nx1       = 64
nx2       = 64
nx3       = 64

<coord>
special_rel = true     # SR MHD metric helpers on (flat spacetime)

<time>
evolution   = dynamic
integrator  = rk2
cfl_number  = 0.3
tlim        = 630.1

<mhd>
eos         = ideal
gamma       = 1.3333333333
reconstruct = ppmx
rsolver     = hlle
dfloor      = 1.0e-8
pfloor      = 3.0e-11
fofc        = true
gamma_max   = 100.0
sigma_max = 100.0

<problem>
pgen_name    = split_monopole
user_srcs    = true

# --- geometry ---
x0           = 0.0 
y0           = 0.0
z0           = 0.0


# --- pulsar ---
Omega   = 0.1    # solid-body rate inside corotation
r_star = 2.0 # radius of the neutron star 
rho0 = 1.0e-8 # density in the SNR (not currently used)
p0 = 3.0e-11 #pressure in SNR (not currently used)
t_ramp  = 20.0    # spin-up timescale (smoothstep 0→Omega over this time); 0 = instant
rho_surf = 1.0 #density at the surface of the neutron star

# --- magnetosphere ---
sigma0           = 100.0    # magnetization
delta = 0.4  # current sheet thickness

#----regulatization ---
frac_star = 0.2 #fraction of the star that is not set by regulatization

# ---------------- Outputs ----------------
<output1>
file_type   = hst
data_format = %12.5e
dt          = 5.0

<output2>
file_type  = bin          # 3D binary dump (full volume)
variable   = mhd_w_bcc        # SR/NR MHD primitives: rho, press, vel1..3, etc.
dt         = 1.0

<output3>
file_type = bin
variable  = mhd_divb
dt        = 1.0
